    <string name="app_language">Sprache der App</string>
    <string name="app_language_system">Wie System</string>
    <string name="app_language_note">Gilt für diese Einstellungen und die Texte der Tastatur, nicht für die Tastatursprachen.</string>
    <string name="languages_intro">Sobald mehr als eine Sprache aktiv ist, zeigt die Tastatur eine Sprachtaste.</string>
    <string name="languages_header">Tastatursprachen</string>
    <string name="languages_min">Eine Sprache muss aktiv bleiben</string>
    <string name="multilingual">In mehreren Sprachen tippen</string>
    <string name="multilingual_note">Vorschläge kommen aus allen gewählten Sprachen; korrigiert wird in der Sprache des Satzes.</string>
    <string name="multilingual_note_many">Vorschläge kommen aus der aktuellen Sprache und den zwei zuletzt benutzten; korrigiert wird in der Sprache des Satzes.</string>
    <string name="multilingual_off">Verfügbar ab zwei Tastatursprachen</string>
    <string name="comma_key">Kommataste bei mehreren Sprachen</string>
    <string name="comma_key_note">Behält die Kommataste neben der Leertaste, wenn die Tastatur eine Sprachtaste zeigt.</string>

    <string name="suggestions">Wortvorschläge beim Tippen zeigen</string>
    <string name="autocorrect">Tippfehler automatisch korrigieren</string>
    <string name="space_after">Nach einem gewählten Vorschlag ein Leerzeichen setzen</string>
    <string name="auto_caps">Satzanfänge automatisch großschreiben</string>
    <string name="double_space">Zwei Leerzeichen hintereinander ergeben einen Punkt</string>
    <string name="shape_writing">Wörter durch Wischen über die Buchstaben schreiben</string>
    <string name="spelling_underline">Unbekannte Wörter unterstreichen</string>
    <string name="spelling_underline_note">Markiert unbekannte und automatisch korrigierte Wörter im Textfeld. Tippen auf ein markiertes Wort zeigt Alternativen, wenn die App das unterstützt.</string>
    <string name="contacts">Namen aus meinen Kontakten vorschlagen</string>
    <string name="contacts_note">Namen deiner Kontakte erscheinen als Vorschläge und gelten als richtig geschrieben.</string>
    <string name="contacts_box_title">Zugriff auf Kontakte</string>
    <string name="contacts_box_text">Dafür liest die Tastatur nur Vornamen, Nachnamen und Spitznamen deiner Kontakte. Sie bleiben im Arbeitsspeicher der Tastatur und werden weder gespeichert noch gesichert oder weitergegeben. Du kannst das jederzeit wieder ausschalten.</string>
    <string name="contacts_continue">Weiter</string>
    <string name="contacts_denied">Ohne Zugriff auf deine Kontakte bleibt diese Einstellung aus.</string>
    <string name="contacts_open_settings">Einstellungen</string>
    <string name="autoswitch_emoji">Nach einem Emoji zurück zu den Buchstaben</string>
    <string name="autoswitch_emoji_note">Nach jedem Emoji wechselt die Tastatur wieder zur Buchstabenseite.</string>

    <string name="clip_history">Zwischenablage-Verlauf</string>
    <string name="clip_history_note">Kopierte Texte bleiben eine Stunde verfügbar, angeheftete dauerhaft. Als vertraulich markierte Inhalte wie Passwörter werden nie gespeichert. Ausschalten löscht den Verlauf.</string>
    <string name="autofill">Vorschläge von Passwortmanagern</string>
    <string name="autofill_note">Autofill-Vorschläge erscheinen direkt in der Vorschlagsleiste (ab Android 11).</string>
    <string name="autofill_unavailable">Benötigt Android 11 oder neuer</string>

    <string name="key_sounds">Tastentöne</string>
    <string name="key_sounds_note">Nur wenn das Telefon nicht auf lautlos oder Vibration steht</string>
    <string name="key_sound_volume">Lautstärke der Tastentöne</string>
    <string name="key_sound_volume_note">Im Verhältnis zur Systemlautstärke. Beim Loslassen hörst du eine Probe.</string>
    <string name="percent">%1$d %%</string>
    <string name="vibration">Beim Tippen vibrieren</string>
    <string name="sound_pack">Tonpaket</string>
    <string name="sound_source_system">Android-Systemklänge</string>
    <string name="sound_source_custom">Eigene Töne</string>
    <string name="sound_intro">MetroKeys verwendet die Klicktöne von Android. Wenn du eigene Tondateien (WAV) hast, kannst du sie hier verwenden: je einen Ton für Buchstabentasten, Leertaste, Funktionstasten, die Auswahl von Alternativen, das Wählen eines Vorschlags und das Hinzufügen zum Wörterbuch. Die Dateien bleiben nur auf diesem Gerät und kommen nicht ins Backup. Importiere nur Dateien, die du verwenden darfst.</string>
    <string name="source">Quelle</string>
    <string name="sound_import">Töne importieren</string>
    <string name="remove">Entfernen</string>
    <string name="sound_slots">Töne</string>
    <string name="sound_slots_note">Fehlt ein Ton, klingt die Taste wie eine Buchstabentaste oder wie Android. Tippen wählt eine Datei, Halten spielt den Ton ab.</string>
