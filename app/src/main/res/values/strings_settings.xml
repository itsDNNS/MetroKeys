    <string name="comma_key_note">Keeps the comma key next to the space bar when the keyboard shows a language key.</string>

    <!-- typing (07 §9.6) -->
    <string name="suggestions">Show word suggestions while typing</string>
    <string name="autocorrect">Fix typos automatically</string>
    <string name="space_after">Add a space after a chosen suggestion</string>
    <string name="auto_caps">Start sentences with a capital letter</string>
    <string name="double_space">Two spaces in a row make a period</string>
    <string name="shape_writing">Write words by sliding across the letters</string>
    <string name="spelling_underline">Underline unknown words</string>
    <string name="spelling_underline_note">Marks unknown and autocorrected words in the text field. Tapping a marked word shows alternatives if the app supports it.</string>
    <string name="contacts">Suggest names from my contacts</string>
    <string name="contacts_note">Your contacts’ names appear as suggestions and count as correctly spelled.</string>
    <string name="contacts_box_title">Access to contacts</string>
    <string name="contacts_box_text">For this the keyboard reads only first names, last names and nicknames of your contacts. They stay in the keyboard’s memory and are never saved, backed up or shared. You can turn this off at any time.</string>
    <string name="contacts_continue">continue</string>
    <string name="contacts_denied">Without access to your contacts, this setting stays off.</string>
    <string name="contacts_open_settings">settings</string>
    <string name="autoswitch_emoji">Back to letters after an emoji</string>
    <string name="autoswitch_emoji_note">After each emoji, the keyboard returns to the letters page.</string>

    <!-- clipboard+autofill (07 §9.7) -->
    <string name="clip_history">Clipboard history</string>
    <string name="clip_history_note">Copied text stays available for an hour, pinned items until you remove them. Content marked as sensitive, such as passwords, is never saved. Turning this off clears the history.</string>
    <string name="autofill">Password manager suggestions</string>
    <string name="autofill_note">Autofill suggestions appear right in the suggestion bar (Android 11 and later).</string>
    <string name="autofill_unavailable">Needs Android 11 or later</string>

